# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tourism_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=redis

# Cloudinary (images are stored there, not on the local server)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT signing secret (use a long random string in production)
JWT_SECRET=dev-only-change-me-please-super-secret-key-2026
# Optional: token lifetime in milliseconds (default 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# Password reset token lifetime in minutes (default 30)
RESET_TOKEN_EXPIRATION_MINUTES=30
