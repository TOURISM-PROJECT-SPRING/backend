# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tourism_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=redis

# Cloudinary (images are stored there, not on the local server)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT signing secret (use a long random string in production)
JWT_SECRET=dev-only-change-me-please-super-secret-key-2026
# Optional: token lifetime in milliseconds (default 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# Password reset token lifetime in minutes (default 30)
RESET_TOKEN_EXPIRATION_MINUTES=30

# Google Gemini AI Key
GERMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- GitHub login (optional) ---
# Create an OAuth app at https://github.com/settings/developers -> New OAuth App.
# Set "Authorization callback URL" to your frontend origin + /login, e.g.
# http://localhost:5173/login
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=your_github_oauth_app_secret
# The frontend also needs VITE_GITHUB_CLIENT_ID with the same client id.

# Facebook login and account linking
# FACEBOOK_APP_ID=your_meta_app_id
# FACEBOOK_APP_SECRET=your_meta_app_secret
# Use the same Google OAuth client ID as the frontend for Google reauthentication.
# GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Local development only. Keep disabled on public deployments.
# DEV_PASSWORD_RESET_ENABLED=false
# Local development only. Enables demo records and accounts with built-in passwords.
# SEED_DEMO_DATA=false
